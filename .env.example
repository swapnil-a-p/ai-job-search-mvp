# ── Apify ────────────────────────────────────────────────────────────────────
APIFY_TOKEN=

# Default actor IDs (community actors — swap if you use different versions)
LINKEDIN_JOBS_ACTOR_ID=2rJKkhh7vjpX7pvjg
GOOGLE_SEARCH_ACTOR_ID=nFJndFXA5zjCTuudP
LINKEDIN_EMPLOYEES_ACTOR_ID=ORFez5SBHRFoxbRVy

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SHEET_NAME=SA-JobHunt-May2026
GOOGLE_SHEET_URL=                          # optional: skip Drive lookup, open known sheet directly

# Set ONE of these (service account must have Sheets Editor access)
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=               # inline JSON string alternative

# ── Gemini LLM enrichment ─────────────────────────────────────────────────────
GEMINI_API_KEY=                            # leave blank to disable LLM enrichment
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI=true
GEMINI_DRY_RUN=false                       # true = skip live API calls (for testing)
DEBUG_LLM_ALL=false                        # true = analyze all jobs, not just shortlist
MAX_GEMINI_CALLS_PER_RUN=10
GEMINI_MAX_JOBS=12
GEMINI_MAX_RESUME_JOBS=10
GEMINI_ONLY_SHORTLIST=true                 # true = only analyze shortlist candidates

# ── LinkedIn throttle ─────────────────────────────────────────────────────────
ENABLE_LINKEDIN_JOBS=true
RUN_LINKEDIN_JOBS_EVERY_N_RUNS=7           # run LinkedIn actor 1 out of every N runs
MAX_LINKEDIN_QUERIES=3

# ── Result limits ─────────────────────────────────────────────────────────────
JOBS_MAX_RESULTS=50
GOOGLE_SEARCH_MAX_RESULTS=30
EMPLOYEE_MAX_RESULTS_PER_COMPANY=10

# ── Employee discovery ────────────────────────────────────────────────────────
ENABLE_LINKEDIN_EMPLOYEE_DISCOVERY=false
MAX_COMPANIES_FOR_EMPLOYEE_DISCOVERY=5
MAX_EMPLOYEES_PER_COMPANY=5

# ── Location & query overrides ────────────────────────────────────────────────
LINKEDIN_JOB_LOCATION=United States

# Override default queries — use JSON arrays or strings separated by ||
LINKEDIN_JOB_QUERIES=
GOOGLE_SEARCH_QUERIES=
EMPLOYEE_ROLE_KEYWORDS=

# Override entire actor input payloads (takes precedence over all defaults)
LINKEDIN_JOBS_ACTOR_INPUT_JSON=
GOOGLE_SEARCH_ACTOR_INPUT_JSON=
LINKEDIN_EMPLOYEES_ACTOR_INPUT_JSON=
